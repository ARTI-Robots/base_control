<?xml version="1.0"?>
<!--
  ROS 2 package manifest (format 2)
  This file defines the package metadata, maintainers, license,
  dependencies, and export information for the arti_base_control_tests package.
-->
<package format="2">
  <name>arti_base_control_tests</name>
  <version>0.0.0</version>
  <description>ROS 2 test nodes for arti_base_control</description>

  <maintainer email="m.honrubia@arti-robots.com">Mario Lopez Honrubia</maintainer>

  <!-- License declaration (replace TODO with correct license) -->
  <!-- Common choices: BSD, MIT, GPLv3, LGPLv3, Apache-2.0 -->
  <license>BSD</license>

  <author email="a.buchegger@arti-robots.com">Alexander Buchegger</author>

  <!--
    In ROS 2, packages use ament_cmake instead of catkin.
    The main build tool dependency must always be:
      <buildtool_depend>ament_cmake</buildtool_depend>

    For normal dependencies, you can keep the explicit separation
    (build_depend, build_export_depend, exec_depend) as in this version,
    or simplify them later into <depend> if desired.
  -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build-time dependencies (headers, include paths, etc.) -->
  <build_depend>ackermann_msgs</build_depend>
  <build_depend>arti_base_control</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>tf2_ros</build_depend>

  <!-- Exported build dependencies (needed by other packages building against this one) -->
  <build_export_depend>ackermann_msgs</build_export_depend>
  <build_export_depend>arti_base_control</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>rclcpp</build_export_depend>
  <build_export_depend>tf2_ros</build_export_depend>

  <!-- Runtime dependencies (required when executing the nodes) -->
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>arti_base_control</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- Example of test-only dependency (if tests are added) -->
  <!-- <test_depend>ament_cmake_gtest</test_depend> -->
  <!--
    The export tag specifies metadata used by the build system.
    For ROS 2 packages using ament_cmake, this must include:
      <build_type>ament_cmake</build_type>
  -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
