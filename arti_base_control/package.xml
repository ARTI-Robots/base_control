<?xml version="1.0"?>
<package format="2">
  <name>arti_base_control</name>
  <version>0.0.1</version>
  <description>The arti_base_control package contains a library and node for controlling a robot base.
  </description>

  <license>BSD</license>

  <maintainer email="a.buchegger@arti-robots.com">Alexander Buchegger</maintainer>

  <author email="a.buchegger@arti-robots.com">Alexander Buchegger</author>
  <author email="c.muehlbacher@arti-robots.com">Clemens Mühlbacher</author>

  <!-- Optional attribute type can be: website, bugtracker, or repository -->
  <!-- <url type="website">http://wiki.ros.org/vesc_differential_drive</url> -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>ackermann_msgs</build_depend>
  <build_depend>arti_base_control_msgs</build_depend>
  <build_depend>angles</build_depend>
  <build_depend>boost</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>eigen</build_depend>
  <build_depend>opencv</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>rclcpp</build_depend>

  <build_export_depend>ackermann_msgs</build_export_depend>
  <build_export_depend>arti_base_control_msgs</build_export_depend>
  <build_export_depend>angles</build_export_depend>
  <build_export_depend>boost</build_export_depend>
  <build_export_depend>eigen</build_export_depend>
  <build_export_depend>opencv</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>pluginlib</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>cv_bridge</build_export_depend>
  <build_export_depend>tf2_ros</build_export_depend>
  <build_export_depend>rclcpp</build_export_depend>

  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>arti_base_control_msgs</exec_depend>
  <exec_depend>angles</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>eigen</exec_depend>
  <exec_depend>boost</exec_depend>
  <exec_depend>opencv</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
