<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arti_base_control_msgs</name>
  <version>0.0.0</version>
  <description>Auxiliary messages used by arti_base_control.</description>
  <license>BSD</license>

  <maintainer email="m.honrubia@arti-robots.com">Mario López Honrubia</maintainer>
  <author email="a.buchegger@arti-robots.com">Alexander Buchegger</author>

  <!-- =============================================================
       General notes
       =============================================================
       In ROS 2, package dependencies and message generation are managed
       through ament_cmake and rosidl_default_generators instead of catkin.
       The structure of this file remains similar to ROS 1, but the
       dependency tags have slightly different meanings.
  -->

  <!-- =============================================================
       URL section (optional)
       =============================================================
       You can provide URLs for documentation, repository, or bugtracker.
       Example:
       <url type="repository">https://github.com/ARTI-Robots/base_control</url>
  -->
  <!-- <url type="website">http://wiki.ros.org/arti_base_control_msgs</url> -->

  <!-- =============================================================
       Dependency tags overview
       =============================================================
       * <buildtool_depend> : build system or generator packages (e.g. ament_cmake)
       * <build_depend>     : packages required at build time
       * <exec_depend>      : packages required at runtime
       * <depend>           : shortcut for both build and exec dependencies
       * <test_depend>      : used only for tests
       * <doc_depend>       : used only for documentation
  -->

  <!-- Build system and generator -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>

  <depend>geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

  <member_of_group>rosidl_interface_packages</member_of_group>
</package>
